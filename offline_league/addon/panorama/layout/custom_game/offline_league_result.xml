<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/offline_league.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/offline_league.js" />
    </scripts>
    <Panel id="LeagueResultHost" class="LeagueResultHost" hittest="false" hittestchildren="true">
    <Panel id="LeagueResultCanvas" class="LeagueCanvas ResultCanvas IsHidden" style="visibility: collapse;" hittest="false" hittestchildren="false">
        <Panel class="CanvasTopBevel" hittest="false" />
        <Panel id="ResultShell" class="ResultShell Card">
            <Label id="ResultTitle" class="ResultTitle" text="Матч завершён" />
            <Label id="ResultSubtitle" class="ResultSubtitle" text="Сохраняем результат…" />
            <Panel id="ResultDetails" class="ResultDetails IsHidden">
                <Label id="ResultRating" class="ResultRating" />
                <Panel id="ResultScoreboard" class="Scoreboard" />
            </Panel>
            <Button id="RetrySaveButton" class="PrimaryButton ResultButton IsHidden">
                <Label text="Повторить сохранение" />
            </Button>
            <Button id="RematchButton" class="PrimaryButton ResultButton IsHidden">
                <Label id="RematchButtonLabel" text="Вернуться в лигу" />
            </Button>
            <Label id="ResultReturnStatus" class="ResultReturnStatus" />
        </Panel>
    </Panel>
    </Panel>
</root>
