<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/offline_league_match.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/offline_league_match.js" />
        <include src="file://{resources}/scripts/custom_game/offline_league_inspect.js" />
    </scripts>
    <Panel class="LeagueMatchHud LeagueLeaveHidden" hittest="false" hittestchildren="true">
        <Button id="LeagueLeaveButton" class="LeagueLeaveButton" tabindex="0">
            <Panel class="LeagueReturnIcon" hittest="false" />
        </Button>
        <Panel id="LeagueAllyInspection" class="LeagueAllyInspection LeagueLeaveHidden" hittest="false">
            <Panel class="LeagueInspectHeader" hittest="false">
                <DOTAHeroImage id="LeagueInspectedHeroPortrait" class="LeagueInspectPortrait" heroimagestyle="landscape" hittest="false" />
                <Label id="LeagueInspectedHeroName" class="LeagueInspectName" hittest="false" />
            </Panel>
            <Panel id="LeagueInspectedItems" class="LeagueInspectedItems" hittest="false" />
        </Panel>
        <Panel id="LeagueLeaveBackdrop" class="LeagueLeaveBackdrop LeagueLeaveHidden">
            <Panel class="LeagueLeaveDialog">
                <Label class="LeagueLeaveTitle" text="Выйти в лигу?" />
                <Label class="LeagueLeaveDescription" text="Текущий матч будет отменён. MMR и калибровка учитывают завершённые матчи." />
                <Label id="LeagueLeaveError" class="LeagueLeaveError LeagueLeaveHidden" />
                <Panel class="LeagueLeaveActions">
                    <Button id="LeagueStayButton" class="LeagueLeaveAction LeagueStayButton" tabindex="0">
                        <Label text="Продолжить матч" />
                    </Button>
                    <Button id="LeagueLeaveConfirm" class="LeagueLeaveAction LeagueLeaveConfirm" tabindex="0">
                        <Label id="LeagueLeaveConfirmLabel" text="Выйти в лигу" />
                    </Button>
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
